# --- Окружение ---
env=local
log_level=20
log_is_json=false

# --- База данных (PostgreSQL, поднимается через docker-compose) ---
db_name=funpay_bot
db_username=postgres
db_password=postgres
db_host=localhost
db_port=5437
db_echo=false

# --- FunPay ---
funpay_golden_key=
funpay_user_agent=
funpay_requests_delay=4
proxy_url=

# --- Telegram (админка) ---
bot_token=
# один админ — admin_id; несколько — admin_ids через запятую (можно вместе)
admin_id=
admin_ids=
secret_phrase=

# --- Шифрование секретов (Fernet key, base64) ---
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
encryption_key=

# --- Параметры аренды ---
hours_for_review=1
warn_before_minutes=10
deauthorize_retries=3
