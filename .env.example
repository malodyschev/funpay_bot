# --- Окружение ---
env=local
log_level=20            # 20=INFO (прод), 10=DEBUG (только для отладки)
log_is_json=false       # на сервере удобнее true (структурные логи)
# Файл логов с суточной ротацией; в Docker маппится на хост через ./logs.
# Пусто = только stdout (docker logs). Для прода: logs/bot.log
log_file=
log_retention_days=5    # сколько дней хранить ротируемые логи

# --- База данных (PostgreSQL) ---
# В Docker db_host/db_port задаёт docker-compose (postgres:5432) и переопределяет
# значения отсюда. Эти — для локального запуска.
# ВАЖНО: смени db_password на сервере (им же инициализируется Postgres).
db_name=funpay_bot
db_username=postgres
db_password=postgres
db_host=localhost
db_port=5437
db_echo=false

# --- FunPay ---
funpay_golden_key=
funpay_user_agent=
funpay_requests_delay=4
# Прокси для FunPay И Steam. На зарубежном сервере (Хельсинки) фактически
# обязателен: при Steam-логине из чужого датацентра аккаунты могут флагаться.
# Поддерживается http(s):// и socks5:// (напр. socks5://user:pass@host:port).
proxy_url=

# --- Telegram (админка) ---
bot_token=
# один админ — admin_id; несколько — admin_ids через запятую (можно вместе)
admin_id=
admin_ids=
secret_phrase=

# --- Шифрование секретов (Fernet key, base64) ---
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
encryption_key=

# --- Параметры аренды ---
hours_for_review=1
warn_before_minutes=10
deauthorize_retries=3
